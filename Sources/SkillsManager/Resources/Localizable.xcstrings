    "Batch update summary: %arg": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "批量更新摘要：%arg" } }, "en": { "stringUnit": { "state": "translated", "value": "Batch update summary: %arg" } } } },
    "Before installation, Skills Manager verifies a unique repository subpath and immutable GitHub revision.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "安装前，Skills Manager 会验证唯一的仓库子路径和不可变 GitHub 修订版本。" } }, "en": { "stringUnit": { "state": "translated", "value": "Before installation, Skills Manager verifies a unique repository subpath and immutable GitHub revision." } } } },
    "Compatible Agents share one managed link in %arg.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "兼容的 Agent 在 %arg 中共享一个托管链接。" } }, "en": { "stringUnit": { "state": "translated", "value": "Compatible Agents share one managed link in %arg." } } } },
    "Discovery": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "发现" } }, "en": { "stringUnit": { "state": "translated", "value": "Discovery" } } } },
    "Loading ": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在加载 " } }, "en": { "stringUnit": { "state": "translated", "value": "Loading " } } } },
    "None will be created": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "不会创建" } }, "en": { "stringUnit": { "state": "translated", "value": "None will be created" } } } },
    "Remains unchanged": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "保持不变" } }, "en": { "stringUnit": { "state": "translated", "value": "Remains unchanged" } } } },
    "Saved in Skill Backups": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "已保存到 Skill 备份" } }, "en": { "stringUnit": { "state": "translated", "value": "Saved in Skill Backups" } } } },
    "This is different from removing Agent links. It backs up the Skill, removes all managed Agent links, and deletes the managed Skill itself.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "这不同于移除 Agent 链接。此操作会备份 Skill、移除所有托管 Agent 链接，并删除托管 Skill 本身。" } }, "en": { "stringUnit": { "state": "translated", "value": "This is different from removing Agent links. It backs up the Skill, removes all managed Agent links, and deletes the managed Skill itself." } } } },
    "%arg differs from the managed version.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 与托管版本不同。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg differs from the managed version." } } } },
    "%arg is already in the managed library.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 已在托管库中。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg is already in the managed library." } } } },
    "%arg is managed and available to the selected Agents.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 已托管，可供所选 Agent 使用。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg is managed and available to the selected Agents." } } } },
    "%arg is managed, but its distribution state must be confirmed or repaired.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 已托管，但必须确认或修复其分发状态。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg is managed, but its distribution state must be confirmed or repaired." } } } },
    "%arg is managed; no distribution changes were needed.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 已托管；无需更改分发。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg is managed; no distribution changes were needed." } } } },
    "%arg is safe in the managed library, but distribution was not applied.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 在托管库中安全，但未应用分发。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg is safe in the managed library, but distribution was not applied." } } } },
    "%arg was updated.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "%arg 已更新。" } }, "en": { "stringUnit": { "state": "translated", "value": "%arg was updated." } } } },
    "Confirm or repair the managed library before retrying.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "重试前请确认或修复托管库。" } }, "en": { "stringUnit": { "state": "translated", "value": "Confirm or repair the managed library before retrying." } } } },
    "Refresh %arg's distribution from its details.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "请从 %arg 的详情刷新分发。" } }, "en": { "stringUnit": { "state": "translated", "value": "Refresh %arg's distribution from its details." } } } },
    "Refresh the library.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "刷新托管库。" } }, "en": { "stringUnit": { "state": "translated", "value": "Refresh the library." } } } },
    "The import state for %arg must be confirmed or repaired before retrying.": { "extractionState": "manual", "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "重试前必须确认或修复 %arg 的导入状态。" } }, "en": { "stringUnit": { "state": "translated", "value": "The import state for %arg must be confirmed or repaired before retrying." } } } },
